{
  "id": "nih",
  "title": "Not Invented Here System, a 5e fork",
  "description": "A system for playing NIH in the Foundry Virtual Tabletop environment.",
  "version": "0.0.1",
  "compatibility": {
    "minimum": "13.347",
    "verified": "13"
  },
  "url": "https://github.com/bentomhall/foundry-nih/",
  "manifest": "https://raw.githubusercontent.com/bentomhall/foundry-nih/main/system.json",
  "download": "https://github.com/bentomhall/foundry-nih/releases/download/release-0.0.1/foundry-release-0.0.1.zip",
  "authors": [
    {
      "name": "AdmiralBenbo",
      "url": "https://wiki.admiralbenbo.com",
      "flags": {}
    }
  ],
  "esmodules": [
    "nih.mjs"
  ],
  "styles": [
    "nih.css"
  ],
  "documentTypes": {
    "ActiveEffect": {
      "enchantment": {}
    },
    "Actor": {
      "character": {
        "htmlFields": ["details.biography.value", "details.biography.public"]
      },
      "encounter": {
        "htmlFields": ["description.full", "description.summary"]
      },
      "group": {
        "htmlFields": ["description.full", "description.summary"]
      },
      "npc": {
        "htmlFields": ["details.biography.value", "details.biography.public"]
      },
      "vehicle": {
        "htmlFields": ["details.biography.value", "details.biography.public"]
      }
    },
    "ChatMessage": {
      "request": {},
      "rest": {},
      "turn": {}
    },
    "Item": {
      "weapon": {
        "filePathFields": {
          "activities.*.img": ["IMAGE"]
        },
        "htmlFields": ["description.value", "description.chat", "unidentified.description"]
      },
      "equipment": {
        "filePathFields": {
          "activities.*.img": ["IMAGE"]
        },
        "htmlFields": ["description.value", "description.chat", "unidentified.description"]
      },
      "consumable": {
        "filePathFields": {
          "activities.*.img": ["IMAGE"]
        },
        "htmlFields": ["description.value", "description.chat", "unidentified.description"]
      },
      "tool": {
        "filePathFields": {
          "activities.*.img": ["IMAGE"]
        },
        "htmlFields": ["description.value", "description.chat", "unidentified.description"]
      },
      "loot": {
        "htmlFields": ["description.value", "description.chat", "unidentified.description"]
      },
      "lineage": {
        "filePathFields": {
          "advancement.*.icon": ["IMAGE"]
        },
        "htmlFields": ["description.value", "description.chat"]
      },
      "culture": {
        "filePathFields": {
          "advancement.*.icon": ["IMAGE"]
        },
        "htmlFields": ["description.value", "description.chat"]
      },
      "background": {
        "filePathFields": {
          "advancement.*.icon": ["IMAGE"]
        },
        "htmlFields": ["description.value", "description.chat"]
      },
      "class": {
        "filePathFields": {
          "advancement.*.icon": ["IMAGE"]
        },
        "htmlFields": ["description.value", "description.chat"]
      },
      "subclass": {
        "filePathFields": {
          "advancement.*.icon": ["IMAGE"]
        },
        "htmlFields": ["description.value", "description.chat"]
      },
      "spell": {
        "filePathFields": {
          "activities.*.img": ["IMAGE"]
        },
        "htmlFields": ["description.value", "description.chat"]
      },
      "feature": {
        "filePathFields": {
          "activities.*.img": ["IMAGE"],
          "advancement.*.icon": ["IMAGE"]
        },
        "htmlFields": ["description.value", "description.chat"]
      },
      "container": {
        "htmlFields": ["description.value", "description.chat", "unidentified.description"]
      },
      "backpack": {
        "htmlFields": ["description.value", "description.chat", "unidentified.description"]
      },
      "facility": {
        "filePathFields": {
          "activities.*.img": ["IMAGE"]
        },
        "htmlFields": ["description.value", "description.chat"]
      }
    },
    "JournalEntryPage": {
      "class": {
        "htmlFields": [
          "details.value",
          "details.additionalHitPoints",
          "description.additionalTraits",
          "description.additionalEquipment",
          "description.subclass"
        ]
      },
      "map": {},
      "rule": {
        "htmlFields": ["tooltip"]
      },
      "spells": {},
      "subclass": {
        "htmlFields": ["details.value"]
      }
    },
    "RegionBehavior": {
      "nih.difficultTerrain": {},
      "nih.rotateArea": {}
    }
  },
  "packs": [
    {
      "name": "heroes",
      "label": "Starter Heroes",
      "system": "nih",
      "path": "packs/heroes",
      "type": "Actor",
      "private": false,
      "flags": {
        "nih": {
          "sourceBook": "SRD 0.1",
          "types": ["character"]
        }
      }
    },
    {
      "name": "monsters",
      "label": "Monsters (SRD)",
      "system": "nih",
      "path": "packs/monsters",
      "type": "Actor",
      "private": false,
      "flags": {
        "nih": {
          "sourceBook": "SRD 0.1",
          "types": ["npc"]
        }
      }
    },
    {
      "name": "items",
      "label": "Items (SRD)",
      "system": "nih",
      "path": "packs/items",
      "type": "Item",
      "private": false,
      "flags": {
        "nih": {
          "sourceBook": "SRD 0.1",
          "types": ["weapon", "equipment", "consumable", "tool", "loot", "feature", "container"]
        }
      }
    },
    {
      "name": "tradegoods",
      "label": "Trade Goods (SRD)",
      "system": "nih",
      "path": "packs/tradegoods",
      "type": "Item",
      "private": false,
      "flags": {
        "nih": {
          "sourceBook": "SRD 0.1",
          "types": ["loot"]
        }
      }
    },
    {
      "name": "spells",
      "label": "Spells (SRD)",
      "system": "nih",
      "path": "packs/spells",
      "type": "Item",
      "private": false,
      "flags": {
        "nih": {
          "sorting": "m",
          "sourceBook": "SRD 0.1",
          "types": ["spell"]
        }
      }
    },
    {
      "name": "cultures",
      "label": "Cultures (SRD)",
      "system": "nih",
      "path": "packs/cultures",
      "type": "Item",
      "private": false,
      "flags": {
        "nih": {
          "sourceBook":"SRD 0.1",
          "types": ["culture"]
        }
      }
    },
    {
      "name": "backgrounds",
      "label": "Backgrounds (SRD)",
      "system": "nih",
      "path": "packs/backgrounds",
      "type": "Item",
      "private": false,
      "flags": {
        "nih": {
          "sourceBook": "SRD 0.1",
          "types": ["background", "feature"]
        }
      }
    },
    {
      "name": "classes",
      "label": "Classes (SRD)",
      "system": "nih",
      "path": "packs/classes",
      "type": "Item",
      "private": false,
      "flags": {
        "nih": {
          "sourceBook": "SRD 0.1",
          "types": ["class"]
        }
      }
    },
    {
      "name": "subclasses",
      "label": "Subclasses (SRD)",
      "system": "nih",
      "path": "packs/subclasses",
      "type": "Item",
      "private": false,
      "flags": {
        "nih": {
          "sourceBook": "SRD 0.1",
          "types": ["subclass"]
        }
      }
    },
    {
      "name": "Features",
      "label": "Class & Subclass Features (SRD)",
      "system": "nih",
      "path": "packs/features",
      "type": "Item",
      "private": false,
      "flags": {
        "nih": {
          "sourceBook": "SRD 0.1",
          "types": ["feature", "weapon"]
        }
      }
    },
    {
      "name": "races",
      "label": "Races (SRD)",
      "system": "nih",
      "path": "packs/races",
      "type": "Item",
      "private": false,
      "flags": {
        "nih": {
          "sourceBook": "SRD 0.1",
          "types": ["race", "feature"]
        }
      }
    },
    {
      "name": "monsterfeatures",
      "label": "Monster Features (SRD)",
      "system": "nih",
      "path": "packs/monsterfeatures",
      "type": "Item",
      "private": false,
      "flags": {
        "nih": {
          "sourceBook": "SRD 0.1",
          "types": ["feature", "weapon"]
        }
      }
    },
    {
      "name": "rules",
      "label": "Rules (SRD)",
      "system": "nih",
      "path": "packs/rules",
      "type": "JournalEntry",
      "private": false,
      "flags": {
        "nih": {
          "display": "table-of-contents"
        }
      }
    },
    {
      "name": "tables",
      "label": "Tables (SRD)",
      "system": "nih",
      "path": "packs/tables",
      "type": "RollTable",
      "private": false,
      "flags": {}
    }
  ],
  "packFolders": [
    {
      "name": "D&D Legacy Content",
      "sorting": "m",
      "color": "#cd2c1e",
      "packs": [
        "rules",
        "tables",
        "heroes"
      ],
      "folders": [
        {
          "name": "Character features",
          "sorting": "m",
          "color": "#b72c1f",
          "packs": [
            "classes",
            "subclasses",
            "classfeatures",
            "backgrounds",
            "races"
          ]
        },
        {
          "name": "Items & Spells",
          "sorting": "m",
          "color": "#941919 ",
          "packs": [
            "items",
            "spells",
            "tradegoods"
          ]
        },
        {
          "name": "Monsters",
          "sorting": "m",
          "color": "#7d160c",
          "packs": [
            "monsters",
            "monsterfeatures"
          ]
        }
      ]
    }
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json",
      "flags": {}
    }
  ],
  "media": [
    {
      "type": "cover",
      "loop": false,
      "flags": {}
    }
  ],
  "socket": true,
  "grid": {
    "distance": 5,
    "units": "ft"
  },
  "primaryTokenAttribute": "attributes.hp",
  "background": "systems/nih/ui/official/nih-background.webp",
  "flags": {
    "compendiumArtMappings": {
      "nih": {
        "mapping": "systems/nih/json/fa-token-mapping.json",
        "credit": "<em>Token artwork by <a href=\"https://www.forgotten-adventures.net/\" target=\"_blank\" rel=\"noopener\">Forgotten Adventures</a>.</em>"
      }
    },
    "nih": {
      "sourceBooks": {
        "SRD 0.1": "SOURCE.BOOK.SRD01"
      }
    },
    "needsMigrationVersion": "5.2.0",
    "compatibleMigrationVersion": "0.8",
    "hotReload": {
      "extensions": ["css", "hbs", "json"],
      "paths": ["nih.css", "templates", "lang"]
    }
  }
}
