<section class="flexcol">
    <div class="note info">
        {{ localize (ifThen isGroup "NIH.REST.Long.Hint.Group" "NIH.REST.Long.Hint.Normal") }}
    </div>

    {{#if fields.length}}
    <fieldset>
        <legend>{{ localize "NIH.REST.Configuration" }}</legend>
        {{> "nih.fieldlist" fields }}
    </fieldset>
    {{/if}}

    {{#if hitPoints.length}}
    <fieldset>
        <legend>{{ localize "NIH.HitPoints" }}</legend>
        {{> "nih.fieldlist" hitPoints }}
    </fieldset>
    {{/if}}

    {{#if request}}
    {{> "systems/nih/templates/actors/rest/rest-request.hbs" }}
    {{/if}}
</section>
